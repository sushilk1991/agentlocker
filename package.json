{
  "name": "agentlocker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "npm run web:build && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc -p packages/sdk/tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:mcp": "node --import tsx scripts/test-mcp.ts",
    "test:browser": "vitest run tests/owner-browser.test.ts",
    "test:smoke": "node --import tsx scripts/smoke.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "cli": "tsx packages/cli/src/index.ts",
    "sdk:build": "tsc -p packages/sdk/tsconfig.json",
    "clients:build": "npm run sdk:build && npm run build --workspace packages/cli",
    "test:clients": "vitest run tests/sdk.test.ts tests/cli.test.ts tests/clients-integration.test.ts",
    "web:build": "vite build",
    "pretest:mcp": "npm run web:build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.105.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251118.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.11",
    "miniflare": "4.20251118.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4",
    "wrangler": "4.50.0"
  },
  "cloudflare": {
    "bindings": {
      "OWNER_TOKEN": {
        "description": "Owner sign-in token. Run `openssl rand -hex 32` on a private terminal. Save it in a password manager. Reuse the existing token on updates."
      },
      "LOCKER_ENCRYPTION_KEY": {
        "description": "Run `openssl rand -base64 32` separately on a private terminal. Keep an offline copy with key version 1. Never replace an existing key during deployment."
      }
    }
  }
}
