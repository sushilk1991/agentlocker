{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentlocker",
  "main": "src/index.ts",
  // Pinned to the runtime used by the local integration and MCP tests.
  "compatibility_date": "2025-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Template names only. Provisioning fills the owner's resource names and ID.
  // Merely setting migrations_dir does not apply SQL: see docs/deploy.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentlocker",
      // Placeholder UUID for local migrations. Provisioning must replace it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "agentlocker-files",
      "remote": false
    }
  ],

  // Run first for HTTPS redirects, then asset origin checks and strict CSP.
  "assets": { "directory": "./dist-web", "binding": "ASSETS", "run_worker_first": true },

  // Expiry/dispatch each minute; bounded file cleanup at most hourly.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Closed until explicitly configured. Never infer these from a request.
    "PUBLIC_ORIGIN": "",
    // Generate once and preserve through upgrades and recovery.
    "DEPLOYMENT_ID": "",
    "ENCRYPTION_KEY_VERSION": "1"
  },
  // OWNER_TOKEN and LOCKER_ENCRYPTION_KEY belong in Worker secrets, never vars.
  // Keep request payloads and credentials out of platform logs.
  "observability": { "enabled": false }
}
